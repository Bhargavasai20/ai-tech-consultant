ANTHROPIC_API_KEY=            # empty = everything runs in MOCK mode (wiring only, not quality)
BRAIN_API_KEY=                # optional shared secret between the three tasks
BRAIN_URL=http://localhost:8001
BRAIN_UA=AITechConsultantBot/0.1 (your-email@example.com)   # tell the help center who is crawling
BRAIN_MIN_DELAY=1.0           # seconds between requests, global
BRAIN_PRICES={}               # e.g. {"claude-haiku-5-5":[IN_PER_MTOK,OUT_PER_MTOK]} from the Anthropic pricing page
SCOPE_RATE=40
COMPANY_NAME=Acme Software
COMPANY_DOMAINS=acme.example
